<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.hiwepy</groupId>
        <artifactId>ddd4j-boot-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-boot-dependencies</relativePath>
    </parent>

    <artifactId>ddd4j-boot-cmpt</artifactId>
    <packaging>pom</packaging>
    <description>Ddd4j Boot Components</description>

    <modules>
        <module>ddd4j-boot-cmpt-crypto</module>
        <module>ddd4j-boot-cmpt-datascope</module>
        <module>ddd4j-boot-cmpt-license</module>
        <module>ddd4j-boot-cmpt-logs</module>
        <module>ddd4j-boot-cmpt-pf4j</module>
        <module>ddd4j-boot-cmpt-cola</module>
        <module>ddd4j-boot-cmpt-satoken</module>
        <module>ddd4j-boot-cmpt-jackson</module>
        <module>ddd4j-boot-cmpt-webmvc</module>
        <module>ddd4j-boot-cmpt-webflux</module>
        <module>ddd4j-boot-cmpt-kafka</module>
        <module>ddd4j-boot-cmpt-external</module>
    </modules>

    <dependencies>
        <!-- For Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-api -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- For Spring Boot Test-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>

