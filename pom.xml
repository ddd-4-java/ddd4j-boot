<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- POM的模型版本 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit defaults from ddd4j-parent（对齐 ddd4j-javalin 模式） -->
    <!-- 版本约束：Spring Boot 锁定 3.4.x，不得升级至 4.x -->
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>1.0.x.20260630-SNAPSHOT</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.ddd4j.boot</groupId>
    <artifactId>ddd4j-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>ddd4j-boot</name>
    <description>Ddd4j Projects For Spring Boot</description>

    <scm>
        <connection>scm:git:https:codeup.aliyun.com/5fdc0afd99b59ba3c5ead757/ddd4j/${project.artifactId}.git</connection>
        <developerConnection>scm:git:https:codeup.aliyun.com/5fdc0afd99b59ba3c5ead757/ddd4j/${project.artifactId}.git</developerConnection>
        <url>https://codeup.aliyun.com/5fdc0afd99b59ba3c5ead757/ddd4j/${project.artifactId}</url>
        <tag>${project.artifactId}</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <revision>2.5.x.20260630-SNAPSHOT</revision>
        <ddd4j.version>1.0.x.20260630-SNAPSHOT</ddd4j.version>
        <!-- Testcontainers 1.x 保持 JDK 8 兼容，并支持近期 Docker Engine。 -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <jna.version>5.13.0</jna.version>
        <commons-lang3.version>3.17.0</commons-lang3.version>
        <artemis.version>2.19.0</artemis.version>
        <!-- Jackson BOM：父 POM 链来自 2.0.x 线（jackson.version=2.22.2），
             但 ddd4j 3.x 主仓已迁 Jackson 3（tools.jackson groupId）。
             显式覆盖版本与坐标与 3.x 一致。 -->
        <tools-jackson-bom.version>3.2.1</tools-jackson-bom.version>
        <!-- Spring Boot 版本（不再继承 spring-boot-starter-parent，需显式声明） -->
        <spring-boot.version>2.5.15</spring-boot.version>
        <java.version>1.8</java.version>
        <!-- Maven Plugin versions -->
        <maven.version>3.6.3</maven.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-flatten-plugin.version>1.8.0</maven-flatten-plugin.version>
        <maven-nexus-staging-plugin.version>1.7.0</maven-nexus-staging-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <!-- Dependency versions -->
        <spring-amqp.version>3.2.5</spring-amqp.version>
        <spring-authorization-server.version>1.4.3</spring-authorization-server.version>
        <spring-batch.version>5.2.2</spring-batch.version>
        <spring-data-bom.version>2024.1.5</spring-data-bom.version>
        <!-- 版本约束：Spring Framework 锁定 6.x，不得升级至 7.x -->
        <spring-framework.version>6.2.19</spring-framework.version>
        <spring-graphql.version>1.3.5</spring-graphql.version>
        <spring-hateoas.version>2.4.1</spring-hateoas.version>
        <spring-integration.version>6.4.4</spring-integration.version>
        <spring-kafka.version>3.3.5</spring-kafka.version>
        <spring-ldap.version>3.2.12</spring-ldap.version>
        <spring-pulsar.version>1.2.5</spring-pulsar.version>
        <spring-restdocs.version>3.0.3</spring-restdocs.version>
        <spring-retry.version>2.0.11</spring-retry.version>
        <spring-security.version>6.4.5</spring-security.version>
        <spring-session.version>3.4.3</spring-session.version>
        <spring-ws.version>4.0.13</spring-ws.version>
    </properties>

    <modules>
        <module>ddd4j-boot-bom</module>
        <module>ddd4j-boot-dependencies</module>
        <module>ddd4j-boot-core</module>
        <module>ddd4j-boot-cache</module>
        <module>ddd4j-boot-web</module>
        <!-- 领域聚合（对齐 ddd4j 库） -->
        <module>ddd4j-boot-data</module>
        <module>ddd4j-boot-auth</module>
        <module>ddd4j-boot-mq</module>
        <module>ddd4j-boot-extensions</module>
        <module>ddd4j-boot-parent</module>
        <module>ddd4j-boot-samples</module>
    </modules>

    <!--开源协议采用Apache 2.0协议-->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- 组织信息 -->
    <organization>
        <name>Hiwepy</name>
        <url>https://wiki.hiwepy.com</url>
    </organization>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>wandl</name>
            <email>hiwepy@gmail.com</email>
            <organization>hiwepy</organization>
            <organizationUrl>https://wiki.hiwepy.com</organizationUrl>
            <roles>
                <role>developer</role>
            </roles>
            <timezone>+8</timezone>
        </developer>
    </developers>

