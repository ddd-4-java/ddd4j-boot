<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot-dependencies</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-boot-mq</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-boot 消息队列 Spring Boot 整合聚合。
        参照 ddd4j-mq 多模块范式：
        - core（通用 MQ 编排 auto-config：MQEventPublisher/MQListenerRegistrar/MQMessageSerialization）
        - 各 broker 桥接 auto-config（kafka/rabbitmq/rocketmq/mqtt 等 13 种）
    </description>

    <subprojects>
        <!-- 核心 -->
        <subproject>ddd4j-boot-mq-core</subproject>
        <!-- Broker 桥接（对齐 ddd4j-mq-{broker}） -->
        <subproject>ddd4j-boot-mq-activemq</subproject>
        <subproject>ddd4j-boot-mq-disruptor</subproject>
        <subproject>ddd4j-boot-mq-kafka</subproject>
        <subproject>ddd4j-boot-mq-mqtt</subproject>
        <subproject>ddd4j-boot-mq-mqtt-mica</subproject>
        <subproject>ddd4j-boot-mq-nats</subproject>
        <subproject>ddd4j-boot-mq-ons</subproject>
        <subproject>ddd4j-boot-mq-pulsar</subproject>
        <subproject>ddd4j-boot-mq-rabbitmq</subproject>
        <subproject>ddd4j-boot-mq-redis-stream</subproject>
        <subproject>ddd4j-boot-mq-rocketmq</subproject>
        <subproject>ddd4j-boot-mq-sqs</subproject>
        <subproject>ddd4j-boot-mq-tdmq</subproject>
    </subprojects>

</project>
