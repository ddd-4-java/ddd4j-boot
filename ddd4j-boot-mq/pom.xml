<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-boot-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-boot-mq</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-boot 消息队列 Spring Boot 整合聚合。
        参照 ddd4j-mq 多模块范式：
        - core（通用 MQ 编排 auto-config：MQEventPublisher/MQListenerRegistrar/MQMessageSerialization）
        - 各 broker 桥接 auto-config（kafka/rabbitmq/rocketmq/mqtt 等 13 种）
    </description>

    <modules>
        <!-- 核心 -->
        <module>ddd4j-boot-mq-core</module>
        <!-- Broker 桥接（对齐 ddd4j-mq-{broker}） -->
        <module>ddd4j-boot-mq-activemq</module>
        <module>ddd4j-boot-mq-disruptor</module>
        <module>ddd4j-boot-mq-kafka</module>
        <module>ddd4j-boot-mq-mqtt</module>
        <module>ddd4j-boot-mq-mqtt-mica</module>
        <module>ddd4j-boot-mq-nats</module>
        <module>ddd4j-boot-mq-ons</module>
        <module>ddd4j-boot-mq-pulsar</module>
        <module>ddd4j-boot-mq-rabbitmq</module>
        <module>ddd4j-boot-mq-redis-stream</module>
        <module>ddd4j-boot-mq-rocketmq</module>
        <module>ddd4j-boot-mq-sqs</module>
        <module>ddd4j-boot-mq-tdmq</module>
    </modules>

</project>
