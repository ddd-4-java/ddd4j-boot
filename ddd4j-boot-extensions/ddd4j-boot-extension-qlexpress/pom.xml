<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-boot-extension-qlexpress</artifactId>
    <description>Ddd4j Boot QL-Express 整合（依赖 ddd4j-extension-qlexpress）</description>

    <dependencies>
        <!-- ddd4j 库：qlexpress 规则引擎领域/应用/基础设施实现 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-extension-qlexpress</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- For Spring Boot AutoConfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- QLExpressConfig 使用 @Configuration / @Bean / ObjectProvider / AnnotationUtils -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- QLExpressConfig.registerHardcodedFunctions 显式引用 Express4Runner -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qlexpress4</artifactId>
        </dependency>
    </dependencies>

</project>
