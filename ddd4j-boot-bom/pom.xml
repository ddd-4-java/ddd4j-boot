<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-boot-bom</artifactId>
    <packaging>pom</packaging>
    <description>Ddd4j Boot BOM (Bill of Materials) - 用于外部项目引用 ddd4j-boot 模块版本管理</description>

    <dependencyManagement>
        <dependencies>
            <!-- Ddd4j Boot 单模块（与 3.4.x 对齐） -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-data</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-mq</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-monitor</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-ddd</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- Ddd4j Boot 扩展模块（与 3.4.x 命名风格对齐：data-/mq-/auth-/extension-/web-） -->
            <!-- data-* -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-data-crypto</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-data-external</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-data-logs</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-data-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- mq-* -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-mq-kafka</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- auth-* -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-auth-datascope</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-auth-license</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-auth-satoken</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-auth-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-auth-shiro</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- extension-* -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-akka</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-cola</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-dubbo</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-excel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-jackson</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-pf4j</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-extension-qlexpress</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- web-* -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-web-validation</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-web-webflux</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-web-webmvc</artifactId>
                <version>${revision}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
