<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-boot-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-boot-samples</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <!-- DDD 分层架构示例（Level 2）：充血 Model + BaseRepository + DDD 注解 -->
        <module>ddd4j-boot-sample-layered</module>
        <module>ddd4j-boot-sample-domain</module>
        <module>ddd4j-boot-sample-adapter</module>
        <module>ddd4j-boot-sample-client</module>
        <module>ddd4j-boot-sample-app</module>
        <module>ddd4j-boot-sample-infrastructure</module>
        <module>ddd4j-boot-sample-common</module>
        <!-- ddd4j 1.0.x 的 Order 示例含 Java 17 record，不进入 Boot 2.x/JDK8 reactor。 -->
        <module>ddd4j-boot-sample-starter-druid</module>
        <module>ddd4j-boot-sample-starter-druid-amqp</module>
        <module>ddd4j-boot-sample-starter-druid-kafka</module>
        <module>ddd4j-boot-sample-starter-druid-mqtt-client1</module>
        <module>ddd4j-boot-sample-starter-druid-mqtt-client2</module>
        <module>ddd4j-boot-sample-starter-druid-mqtt-server</module>
        <module>ddd4j-boot-sample-starter-druid-rocketmq</module>
        <module>ddd4j-boot-sample-starter-druid-war</module>
        <module>ddd4j-boot-sample-starter-hikaricp</module>
        <module>ddd4j-boot-sample-starter-hikaricp-amqp</module>
        <module>ddd4j-boot-sample-starter-hikaricp-kafka</module>
        <module>ddd4j-boot-sample-starter-hikaricp-rocketmq</module>
        <module>ddd4j-boot-sample-starter-hikaricp-war</module>
        <module>ddd4j-boot-sample-starter-r2dbc-webflux</module>
        <!-- Auth 鉴权示例：演示 SubjectKit 统一鉴权入口（与 ddd4j-samples 同源） -->
        <module>ddd4j-boot-sample-auth-satoken</module>
        <module>ddd4j-boot-sample-auth-security</module>
        <module>ddd4j-boot-sample-auth-shiro</module>
    </modules>

</project>
