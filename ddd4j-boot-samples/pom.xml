<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-boot-samples</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <subprojects>
        <!-- DDD 分层架构示例（Level 2）：充血 Model + BaseRepository + DDD 注解 -->
        <subproject>ddd4j-boot-sample-layered</subproject>
        <subproject>ddd4j-boot-sample-domain</subproject>
        <subproject>ddd4j-boot-sample-adapter</subproject>
        <subproject>ddd4j-boot-sample-client</subproject>
        <subproject>ddd4j-boot-sample-app</subproject>
        <subproject>ddd4j-boot-sample-infrastructure</subproject>
        <subproject>ddd4j-boot-sample-common</subproject>
        <!-- 共享 Order 内核的 Boot 接线示例，覆盖 DDD、CQRS、Bearer 与幂等用例。 -->
        <subproject>ddd4j-boot-sample-order</subproject>
        <subproject>ddd4j-boot-sample-starter-druid</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-amqp</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-kafka</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-mqtt-client1</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-mqtt-client2</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-mqtt-server</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-rocketmq</subproject>
        <subproject>ddd4j-boot-sample-starter-druid-war</subproject>
        <subproject>ddd4j-boot-sample-starter-hikaricp</subproject>
        <subproject>ddd4j-boot-sample-starter-hikaricp-amqp</subproject>
        <subproject>ddd4j-boot-sample-starter-hikaricp-kafka</subproject>
        <subproject>ddd4j-boot-sample-starter-hikaricp-rocketmq</subproject>
        <subproject>ddd4j-boot-sample-starter-hikaricp-war</subproject>
        <subproject>ddd4j-boot-sample-starter-r2dbc-webflux</subproject>
        <!-- Auth 鉴权示例：演示 SubjectKit 统一鉴权入口（与 ddd4j-samples 同源） -->
        <subproject>ddd4j-boot-sample-auth-satoken</subproject>
        <subproject>ddd4j-boot-sample-auth-security</subproject>
        <subproject>ddd4j-boot-sample-auth-shiro</subproject>
    </subprojects>

</project>
