<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    verify-java-style.sh 引用的 NeedBraces 规则配置。
    配置与 ddd4j 库仓 tools/checkstyle/need-braces-checkstyle.xml 保持一致：
    if/else/for/do/while 单行语句也必须带大括号。
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="NeedBraces">
            <property name="tokens"
                      value="LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,LITERAL_DO,LITERAL_WHILE"/>
            <property name="allowSingleLineStatement" value="false"/>
        </module>
    </module>
</module>
