<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.boot</groupId>
        <artifactId>ddd4j-boot-dependencies</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-boot-auth</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-boot 认证授权整合聚合：satoken / security / shiro 三鉴权、license 授权校验，与 Spring Boot 深度整合。
        底层复用 io.ddd4j:ddd4j-auth-* 纯 Java 实现，本层提供 Spring Boot 自动装配、异常处理、Starter 封装。
    </description>

    <subprojects>
        <subproject>ddd4j-boot-auth-satoken</subproject>
        <subproject>ddd4j-boot-auth-security</subproject>
        <subproject>ddd4j-boot-auth-shiro</subproject>
        <subproject>ddd4j-boot-auth-license</subproject>
    </subprojects>

</project>
